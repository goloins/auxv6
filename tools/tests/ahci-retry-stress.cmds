# AHCI deterministic recovery injection test using /proc/ahci_tune controls.
# The script verifies retry/recover behavior for timeout, TFES, and idle-stall
# classes and then confirms mounted I/O still succeeds.

mkdir /mnt/ahciretry

# Keep test deterministic and bounded.
echo rw_retries=2 > /proc/ahci_tune
echo reset_stats=1 > /proc/ahci_tune
cat /proc/ahci_tune
EXPECT rw_retries=2
EXPECT test_fail_mode=0
EXPECT test_fail_remaining=0
EXPECT last_fail_class=0

# Inject timeout failures for first two write attempts; third should succeed.
echo test_fail_mode=timeout > /proc/ahci_tune
echo test_fail_count=2 > /proc/ahci_tune
mount /dev/hdd ext2 /mnt/ahciretry
echo timeoutok > /mnt/ahciretry/t1
cat /proc/ahci_tune
EXPECT test_fail_mode=1
EXPECT test_fail_remaining=0
EXPECT last_fail_class=1
EXPECT timeout=2
EXPECT retry=2
EXPECT recover_fail=0
umount /mnt/ahciretry

# Inject one TFES failure and verify retry/recovery.
echo test_fail_mode=tfes > /proc/ahci_tune
echo test_fail_count=1 > /proc/ahci_tune
mount /dev/hdd ext2 /mnt/ahciretry
echo tfesok > /mnt/ahciretry/t2
cat /proc/ahci_tune
EXPECT test_fail_mode=2
EXPECT test_fail_remaining=0
EXPECT last_fail_class=2
EXPECT tfes=1
EXPECT retry=3
EXPECT recover_fail=0
umount /mnt/ahciretry

# Inject one pre-command idle stall and verify recovery path.
echo test_fail_mode=idle > /proc/ahci_tune
echo test_fail_count=1 > /proc/ahci_tune
mount /dev/hdd ext2 /mnt/ahciretry
echo idleok > /mnt/ahciretry/t3
cat /proc/ahci_tune
EXPECT test_fail_mode=3
EXPECT test_fail_remaining=0
EXPECT last_fail_class=3
EXPECT timeout=3
EXPECT retry=4
EXPECT recover_fail=0

# Return injector to neutral mode and verify persisted data remains readable.
echo test_fail_mode=none > /proc/ahci_tune
echo test_fail_count=0 > /proc/ahci_tune
cat /proc/ahci_tune
EXPECT test_fail_mode=0
EXPECT test_fail_remaining=0

cat /mnt/ahciretry/t1
EXPECT timeoutok
cat /mnt/ahciretry/t2
EXPECT tfesok
cat /mnt/ahciretry/t3
EXPECT idleok
umount /mnt/ahciretry
