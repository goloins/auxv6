# Makefile.auxv6 - dwm 6.8 build for auxv6/x6
#
# This file is intentionally separate from upstream Makefile so we can
# iterate on auxv6/x6 integration without changing default host builds.

PORTS_COMMON_CALLER := $(lastword $(MAKEFILE_LIST))
include $(dir $(abspath $(PORTS_COMMON_CALLER)))../../config/ports-common.mk

DWM_DIR := $(ROOT)/ports/dwm-6.8
OUT := $(DWM_DIR)/_dwm

VERSION = 6.8

# x6/X11 compatibility wiring.
#
# Expected model:
# - Headers are provided under $(ROOT)/include/X11/... (or override X11INC)
# - Libraries come from auxv6 userspace build output (or override X11LIB)
X11INC ?= $(ROOT)/include
X11LIB ?= $(ROOT)/user

# Keep defaults close to dwm upstream names; override as x6 shims land.
XINERAMALIBS ?=
XINERAMAFLAGS ?=
FREETYPELIBS ?=
FREETYPEINC ?=

INCS := -I$(X11INC) -I$(FREETYPEINC) -I$(ROOT)/include -I$(ROOT)/include/posix -I$(ROOT)/include/posix/sys
LIBS := $(XINERAMALIBS) $(FREETYPELIBS)

CPPFLAGS := -D_DEFAULT_SOURCE -D_BSD_SOURCE -D_XOPEN_SOURCE=700L -DVERSION=\"$(VERSION)\" -DAUXV6 $(XINERAMAFLAGS)
CFLAGS := -fno-pic -static -fno-builtin -fno-strict-aliasing -O2 -Wall -MD -ggdb -m32 \
          -fno-omit-frame-pointer -nostdinc -fno-stack-protector -Wno-error \
          -std=c99 -pedantic -Wno-deprecated-declarations \
          $(INCS) $(CPPFLAGS)
LDFLAGS := -N -e _start -Ttext 0 -m $(shell $(LD) -V 2>/dev/null | grep elf_i386 | head -1)

SRC := $(DWM_DIR)/drw.c $(DWM_DIR)/dwm.c $(DWM_DIR)/util.c
OBJ := $(SRC:.c=.o)

RUNTIME_INPUTS := $(AUXV6_CRT0_OBJ) $(AUXV6_X11_A) $(AUXV6_AUXRT_A) $(AUXV6_LIBC_A)

.PHONY: all clean toolchain-check config-check check-host-contamination

all: toolchain-check config-check $(OUT) check-host-contamination

toolchain-check:
	@$(CC) -m32 -dM -E -x c /dev/null | grep -q '__i386__' || \
		(echo "ERROR: $(CC) is not producing i386 output with -m32" >&2; exit 1)

config-check:
	@test -f $(DWM_DIR)/config.h || \
		(echo "ERROR: $(DWM_DIR)/config.h is missing. Create/manage it manually; build will not modify it." >&2; exit 1)

$(DWM_DIR)/%.o: $(DWM_DIR)/%.c $(DWM_DIR)/config.h
	$(CC) -c $(CFLAGS) -o $@ $<

$(RUNTIME_INPUTS):
	$(MAKE) -C $(ROOT) $(patsubst $(ROOT)/%,%,$@)

$(OUT): $(OBJ) $(RUNTIME_INPUTS) ; $(LD) $(LDFLAGS) -o $@ $(AUXV6_CRT0_OBJ) $(OBJ) $(AUXV6_X11_A) $(LIBS) $(AUXV6_AUXRT_A) $(AUXV6_LIBC_A) $(LIBGCC); $(OBJDUMP) -S $@ > $(DWM_DIR)/dwm-auxv6.asm || true

check-host-contamination: ; @! find "$(DWM_DIR)" -name '*.d' -type f -print0 2>/dev/null | xargs -0 grep -En '/usr/include|/usr/local/include|/opt/homebrew/include|/Library/Developer/CommandLineTools/usr/include|/Applications/Xcode.*/usr/include' >/dev/null || (echo "ERROR: host header path detected in dwm port dependency files" >&2; echo "Inspect ports/dwm-6.8/*.d for details." >&2; exit 1)

clean:
	rm -f $(OBJ) $(OUT) $(SRC:.c=.d)
