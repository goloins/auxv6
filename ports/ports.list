# name|url|class|source_dir|binary_name
# class: system/helper -> /bin, user -> /usr/bin, sbin -> /usr/sbin
# source_dir defaults to name when omitted.
# binary_name defaults to name when omitted.
# In-tree ports dash,dwm,st are ignored by sync/build automation.
# Granular selection is controlled by ports/ports-enabled.list.

# Example:
# icewm|https://github.com/ice-wm/icewm/releases/download/3.8.0/icewm-3.8.0.tar.gz|user|icewm-3.8.0|icewm

# Non-first-class shell preparation lane: first configure/build pass only.
bash|https://ftp.gnu.org/gnu/bash/bash-5.2.37.tar.gz|user|bash-5.2.37|bash

# Non-first-class TLS preparation lane: first configure/build pass only.
libressl|https://github.com/libressl/portable/releases/download/v4.2.1/libressl-4.2.1.tar.gz|user|libressl-4.2.1|libressl

# Non-first-class C compiler preparation lane: first configure/build pass only.
lacc|https://github.com/larmel/lacc/archive/refs/heads/master.zip|user|lacc-master|lacc

# Non-first-class archive utility preparation lane: first configure/build pass only.
p7zip|https://github.com/ip7z/7zip/archive/refs/tags/26.00.zip|user|7zip-26.00|p7zip

# Non-first-class SSH preparation lane: first configure/build pass only.
openssh|https://mirror.planetunix.net/pub/OpenBSD/OpenSSH/portable/openssh-10.3p1.tar.gz|user|openssh-10.3p1|ssh
openssh|https://mirror.planetunix.net/pub/OpenBSD/OpenSSH/portable/openssh-10.3p1.tar.gz|user|openssh-10.3p1|ssh-keygen
openssh|https://mirror.planetunix.net/pub/OpenBSD/OpenSSH/portable/openssh-10.3p1.tar.gz|sbin|openssh-10.3p1|sshd
