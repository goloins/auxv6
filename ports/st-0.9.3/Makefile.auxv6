# Makefile.auxv6 - st 0.9.3 build for auxv6/x6
#
# This lane mirrors ports/dwm-6.8/Makefile.auxv6 so we can iterate on
# auxv6 integration independently of upstream host build defaults.

PORTS_COMMON_CALLER := $(lastword $(MAKEFILE_LIST))
include $(dir $(abspath $(PORTS_COMMON_CALLER)))../../config/ports-common.mk

ST_DIR := $(ROOT)/ports/st-0.9.3
OUT := $(ST_DIR)/_st

VERSION = 0.9.3

# x6/X11 compatibility wiring.
#
# Expected model:
# - Headers under $(ROOT)/include/X11/... (or override X11INC)
# - Runtime symbols from auxv6 userspace object set (or override X11LIB)
X11INC ?= $(ROOT)/include
X11LIB ?= $(ROOT)/user

INCS := -I$(ST_DIR)/compat -I$(X11INC) -I$(ROOT)/include -I$(ROOT)/include/posix -I$(ROOT)/include/posix/sys
CPPFLAGS := -DVERSION=\"$(VERSION)\" -D_XOPEN_SOURCE=600 -D_DEFAULT_SOURCE -DAUXV6
CFLAGS := -fno-pic -static -fno-builtin -fno-strict-aliasing -O2 -Wall -MD -ggdb -m32 \
          -fno-omit-frame-pointer -nostdinc -fno-stack-protector -Wno-error \
          -std=c99 -pedantic -Wno-deprecated-declarations \
          $(INCS) $(CPPFLAGS)
LDFLAGS := -N -e _start -Ttext 0 -m $(shell $(LD) -V 2>/dev/null | grep elf_i386 | head -1)

SRC := $(ST_DIR)/st.c $(ST_DIR)/x.c $(ST_DIR)/compat/wchar.c
OBJ := $(SRC:.c=.o)

RUNTIME_INPUTS := $(AUXV6_CRT0_OBJ) $(AUXV6_X11_A) $(AUXV6_AUXRT_A) $(AUXV6_LIBC_A)


.PHONY: all clean toolchain-check check-host-contamination

all: toolchain-check $(OUT) check-host-contamination

toolchain-check:
	@$(CC) -m32 -dM -E -x c /dev/null | grep -q '__i386__' || \
		(echo "ERROR: $(CC) is not producing i386 output with -m32" >&2; exit 1)

$(ST_DIR)/%.o: $(ST_DIR)/%.c $(ST_DIR)/config.h
	$(CC) -c $(CFLAGS) -o $@ $<

$(RUNTIME_INPUTS):
	$(MAKE) -C $(ROOT) $(patsubst $(ROOT)/%,%,$@)

$(OUT): $(OBJ) $(RUNTIME_INPUTS) ; $(LD) $(LDFLAGS) -o $@ $(AUXV6_CRT0_OBJ) $(OBJ) $(AUXV6_X11_A) $(AUXV6_AUXRT_A) $(AUXV6_LIBC_A) $(LIBGCC); $(OBJDUMP) -S $@ > $(ST_DIR)/st-auxv6.asm || true

check-host-contamination: ; @! find "$(ST_DIR)" -name '*.d' -type f -print0 2>/dev/null | xargs -0 grep -En '/usr/include|/usr/local/include|/opt/homebrew/include|/Library/Developer/CommandLineTools/usr/include|/Applications/Xcode.*/usr/include' >/dev/null || (echo "ERROR: host header path detected in st port dependency files" >&2; echo "Inspect ports/st-0.9.3/*.d for details." >&2; exit 1)

clean:
	rm -f $(OBJ) $(OUT) $(SRC:.c=.d)
