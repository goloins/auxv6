# Makefile.auxv6 - dmenu 5.4 build for auxv6/x6
#
# This is kept separate from upstream Makefile so auxv6-specific include paths,
# linker inputs, and helper staging do not require editing the vendored port.

PORTS_COMMON_CALLER := $(lastword $(MAKEFILE_LIST))
include $(dir $(abspath $(PORTS_COMMON_CALLER)))../../config/ports-common.mk

DMENU_DIR := $(ROOT)/ports/dmenu-5.4
BUILD_DIR := $(ROOT)/user/.stage/dmenu-5.4
DMENU_OUT := $(DMENU_DIR)/_dmenu
STEST_OUT := $(DMENU_DIR)/_stest

VERSION = 5.4

X11INC ?= $(ROOT)/include

INCS := -I$(BUILD_DIR) -I$(DMENU_DIR) -I$(ROOT)/include/posix -I$(ROOT)/include/posix/sys -I$(X11INC)
CPPFLAGS := -D_DEFAULT_SOURCE -D_BSD_SOURCE -D_XOPEN_SOURCE=700L -D_POSIX_C_SOURCE=200809L \
	-DVERSION=\"$(VERSION)\" -DXINERAMA -DAUXV6
CFLAGS := -fno-pic -static -fno-builtin -fno-strict-aliasing -O2 -Wall -MD -ggdb -m32 \
	-fno-omit-frame-pointer -nostdinc -fno-stack-protector -Wno-error \
	-std=c99 -pedantic -Wno-deprecated-declarations \
	$(INCS) $(CPPFLAGS)
LDFLAGS := -N -e _start -Ttext 0 -m $(shell $(LD) -V 2>/dev/null | grep elf_i386 | head -1)

COMMON_RUNTIME_INPUTS := $(AUXV6_CRT0_OBJ) $(AUXV6_AUXRT_A) $(AUXV6_LIBC_A)
DMENU_RUNTIME_INPUTS := $(AUXV6_X11_A) $(COMMON_RUNTIME_INPUTS)
STEST_RUNTIME_INPUTS := $(COMMON_RUNTIME_INPUTS)

DMENU_CONFIG := $(BUILD_DIR)/config.h
DMENU_OBJ := $(BUILD_DIR)/dmenu.o $(BUILD_DIR)/drw.o $(BUILD_DIR)/util.o
STEST_OBJ := $(BUILD_DIR)/stest.o $(BUILD_DIR)/util.o
DMENU_ELF := $(BUILD_DIR)/dmenu
STEST_ELF := $(BUILD_DIR)/stest

.PHONY: all clean toolchain-check config-check check-host-contamination

all: toolchain-check config-check $(DMENU_OUT) $(STEST_OUT) check-host-contamination

toolchain-check:
	@$(CC) -m32 -dM -E -x c /dev/null | grep -q '__i386__' || \
		(echo "ERROR: $(CC) is not producing i386 output with -m32" >&2; exit 1)

config-check:
	@test -f $(DMENU_DIR)/config.def.h || \
		(echo "ERROR: $(DMENU_DIR)/config.def.h is missing." >&2; exit 1)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(DMENU_CONFIG): $(DMENU_DIR)/config.def.h | $(BUILD_DIR)
	cp $< $@

$(BUILD_DIR)/%.o: $(DMENU_DIR)/%.c $(DMENU_CONFIG) | $(BUILD_DIR)
	$(CC) -c $(CFLAGS) -o $@ $<

$(COMMON_RUNTIME_INPUTS) $(AUXV6_X11_A):
	$(MAKE) -C $(ROOT) $(patsubst $(ROOT)/%,%,$@)

$(DMENU_ELF): $(DMENU_OBJ) $(DMENU_RUNTIME_INPUTS)
	$(LD) $(LDFLAGS) -o $@ $(AUXV6_CRT0_OBJ) $(DMENU_OBJ) $(AUXV6_X11_A) $(AUXV6_AUXRT_A) $(AUXV6_LIBC_A) $(LIBGCC)
	$(OBJDUMP) -S $@ > $(BUILD_DIR)/dmenu.asm || true
	$(OBJDUMP) -t $@ | sed '1,/SYMBOL TABLE/d; s/ .* / /; /^$$/d' > $(BUILD_DIR)/dmenu.sym || true

$(STEST_ELF): $(STEST_OBJ) $(STEST_RUNTIME_INPUTS)
	$(LD) $(LDFLAGS) -o $@ $(AUXV6_CRT0_OBJ) $(STEST_OBJ) $(AUXV6_AUXRT_A) $(AUXV6_LIBC_A) $(LIBGCC)
	$(OBJDUMP) -S $@ > $(BUILD_DIR)/stest.asm || true
	$(OBJDUMP) -t $@ | sed '1,/SYMBOL TABLE/d; s/ .* / /; /^$$/d' > $(BUILD_DIR)/stest.sym || true

$(DMENU_OUT): $(DMENU_ELF)
	cp $< $@

$(STEST_OUT): $(STEST_ELF)
	cp $< $@

check-host-contamination:
	@! find "$(BUILD_DIR)" "$(DMENU_DIR)" -name '*.d' -type f -print0 2>/dev/null | \
		xargs -0 grep -En '/usr/include|/usr/local/include|/opt/homebrew/include|/Library/Developer/CommandLineTools/usr/include|/Applications/Xcode.*/usr/include' >/dev/null || \
		(echo "ERROR: host header path detected in dmenu port dependency files" >&2; \
		echo "Inspect ports/dmenu-5.4 and user/.stage/dmenu-5.4 .d files for details." >&2; \
		exit 1)

clean:
	rm -f $(DMENU_OUT) $(STEST_OUT)
	rm -rf $(BUILD_DIR)